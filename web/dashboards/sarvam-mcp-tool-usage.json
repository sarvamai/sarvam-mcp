      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "logs",
              "aggregateOperator": "count",
              "filters": {
                "items": [
                  {
                    "key": { "key": "body", "dataType": "string", "isColumn": true },
                    "op": "=",
                    "value": "tool_used"
                  }
                ],
                "op": "AND"
              },
              "groupBy": [
                {
                  "key": "mcp.status",
                  "dataType": "string",
                  "type": "tag",
                  "isColumn": false
                }
              ],
              "expression": "A",
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "by-tool",
      "title": "Calls by Tool",
      "description": "Which MCP tools are used most",
      "panelTypes": "table",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
