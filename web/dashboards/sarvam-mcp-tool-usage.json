                  }
                ],
                "op": "AND"
              },
              "groupBy": [
                {
                  "key": "mcp.tool",
                  "dataType": "string",
                  "type": "tag",
                  "isColumn": false
                }
              ],
              "orderBy": [{ "columnName": "#SIGNOZ_VALUE", "order": "desc" }],
              "expression": "A",
              "disabled": false
            }
          ],
          "queryFormulas": []
        }
      }
    },
